// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @map("id") @db.VarChar(128)
  fullName           String        @map("full_name") @db.VarChar(100)
  email              String        @unique @db.VarChar(100)
  mobileNumber       String?       @map("mobile_number") @db.VarChar(20)
  dietaryPreference  String        @default("None") @map("dietary_preference") @db.VarChar(50)
  passwordHash       String?       @map("password_hash") @db.VarChar(255)
  avatarUrl          String?       @map("avatar_url") @db.VarChar(255)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  mealPlans          MealPlan[]
  groceryLists       GroceryList[]

  @@map("users")
}

model Recipe {
  id                 Int                @id @default(autoincrement()) @map("id")
  recipeName         String             @unique @map("recipe_name") @db.VarChar(150)
  category           String             @default("Uncategorized") @db.VarChar(50)
  cookingTime        Int                @default(0) @map("cooking_time")
  difficultyLevel    String             @default("Easy") @map("difficulty_level") @db.VarChar(20)
  instructions       String             @db.Text
  imageUrl           String?            @map("image_url") @db.VarChar(255)
  calories           Int                @default(0)
  protein            Float              @default(0)
  carbs              Float              @default(0)
  fat                Float              @default(0)
  fiber              Float              @default(0)
  vitamins           String?            @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  recipeIngredients  RecipeIngredient[]
  mealPlans          MealPlan[]

  @@map("recipes")
}

model Ingredient {
  id                 Int                @id @default(autoincrement()) @map("id")
  ingredientName     String             @unique @map("ingredient_name") @db.VarChar(100)
  category           String             @default("Pantry") @db.VarChar(50)
  recipeIngredients  RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipeId     Int        @map("recipe_id")
  ingredientId Int        @map("ingredient_id")
  quantity     String     @default("as needed") @db.VarChar(50)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model MealPlan {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    String   @map("user_id") @db.VarChar(128)
  recipeId  Int      @map("recipe_id")
  mealType  String   @map("meal_type") @db.VarChar(30)
  mealDate  DateTime @map("meal_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("meal_plans")
}

model GroceryList {
  id             Int      @id @default(autoincrement()) @map("id")
  userId         String   @map("user_id") @db.VarChar(128)
  ingredientName String   @map("ingredient_name") @db.VarChar(100)
  quantity       String   @default("as needed") @db.VarChar(50)
  status         String   @default("Pending") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("grocery_lists")
}

model Admin {
  id           Int      @id @default(autoincrement()) @map("id")
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("Admin") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("admins")
}
