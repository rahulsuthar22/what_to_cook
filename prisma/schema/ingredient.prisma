// ============================================================
// INGREDIENT & MEASUREMENT UNITS
// ============================================================

model Ingredient {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(150)
  slug String @unique @db.VarChar(180)

  recipes          RecipeIngredient[]
  allergens        IngredientAllergen[]
  dislikedByUsers  UserDislikedIngredient[]
  groceryListItems GroceryListItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@map("ingredients")
}

model Unit {
  id String @id @default(uuid()) @db.Uuid

  name   String  @unique @db.VarChar(100)
  symbol String? @db.VarChar(20)

  recipeIngredients RecipeIngredient[]
  groceryListItems  GroceryListItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("units")
}

model IngredientAllergen {
  ingredientId String @map("ingredient_id") @db.Uuid
  allergenId   String @map("allergen_id") @db.Uuid

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen   Allergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergenId])
  @@index([allergenId])
  @@map("ingredient_allergens")
}

